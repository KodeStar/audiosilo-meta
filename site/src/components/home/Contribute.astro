---
import Icon from '../Icon.astro'

const REPO = 'https://github.com/kodestar/audiosilo-meta'

const cards = [
  {
    image: '/img/card/contrib-write.webp',
    title: 'Characters and recaps',
    body: 'See which books still need a spoiler-aware character guide or a story-so-far recap, then write one in your own words with the guided builder.',
    cta: 'See what needs work',
    href: '/contribute',
    external: false,
  },
  {
    image: '/img/card/contrib-import.webp',
    title: 'Import your library',
    body: 'Drop an OpenAudible or Libation export - or a folder scan - and check what is already catalogued, right in your browser. Then contribute the new books.',
    cta: 'Open the import tool',
    href: '/import',
    external: false,
  },
  {
    image: '/img/card/contrib-abs.webp',
    title: 'Use it in Audiobookshelf',
    body: 'Enrich an Audiobookshelf library with community metadata - narrators, chapters, series and covers - or submit your ABS library so the gaps get filled.',
    cta: 'How it works',
    href: '/audiobookshelf',
    external: false,
  },
  {
    image: '/img/card/contrib-fix.webp',
    title: 'Add or fix data',
    body: 'Spotted a missing narrator, a wrong runtime, or a book that is not here yet? Open an issue form - no JSON required - and it becomes a pull request.',
    cta: 'Open an issue',
    href: `${REPO}/issues/new/choose`,
    external: true,
  },
  {
    image: '/img/card/contrib-community.webp',
    title: 'Join the community',
    body: 'Coordinate contributions, ask for help, and help shape the schema on the AudioSilo Discord and in GitHub Discussions.',
    cta: 'Join the Discord',
    href: 'https://discord.gg/nFFqRbkRn6',
    external: true,
  },
] as const
---

<!-- overflow-hidden clips the full-bleed decorative glow (right-[-8rem] extends
     past the right viewport edge) to this section, so it never adds page-wide
     horizontal scroll. No open dropdown lives here, so clipping the section
     directly is safe (unlike the hero, which needs an inset wrapper). -->
<section id="contribute" class="relative scroll-mt-24 overflow-hidden py-20">
  <div class="glow right-[-8rem] top-10 h-[26rem] w-[26rem]"></div>
  <div class="container relative z-10">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.2em] text-pink-500">
        Community maintained
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-hi sm:text-4xl">
        The database grows when you contribute
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        Everything here is real, verifiable and dedicated to the public domain. There
        are no accounts and no gatekeepers - every change goes through GitHub.
      </p>
    </div>

    <div class="reveal mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <div class="contrib-card flex flex-col p-6">
            <div
              class="contrib-card__art"
              style={`background-image:url('${card.image}')`}
              aria-hidden="true"
            />
            <h3 class="relative text-lg font-semibold text-hi">{card.title}</h3>
            <p class="relative mt-3 flex-grow text-sm leading-relaxed text-body">{card.body}</p>
            <a
              href={card.href}
              {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}
              class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-pink-400 transition-colors hover:text-pink-300"
            >
              {card.cta}
              <Icon name="arrowRight" class="h-4 w-4" />
            </a>
          </div>
        ))
      }
    </div>

    <!-- The one restrained pink CTA moment. -->
    <div class="reveal mt-14">
      <div class="cta-panel px-6 py-10 text-center sm:px-10">
        <div class="cta-panel__art" aria-hidden="true"></div>
        <div class="cta-panel__wash" aria-hidden="true"></div>
        <h3 class="relative text-2xl font-bold tracking-tight text-hi sm:text-3xl">
          Help build the audiobook database that should already exist
        </h3>
        <p class="relative mx-auto mt-3 max-w-xl text-body">
          Open source, audiobook-first, and free for anyone to use - starting
          with the narrators, recordings and chapters every other database
          leaves out.
        </p>
        <div class="relative mt-7 flex flex-wrap items-center justify-center gap-3">
          <a
            href={REPO}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-pink-600 px-6 py-3 font-medium text-white shadow-lg shadow-pink-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-pink-500"
          >
            <Icon name="github" class="h-5 w-5" />
            Explore the repository
          </a>
          <a
            href={`${REPO}/blob/main/CONTRIBUTING.md`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-edge px-6 py-3 font-medium text-hi transition-all duration-200 hover:-translate-y-0.5 hover:border-pink-500"
          >
            How to contribute
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Same recipe as the value cards: the art is composed subject-upper-right,
     black lower-left, which is where the heading, body and link sit. */
  .contrib-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--color-edge);
    background: var(--color-surface);
    transition: border-color 0.25s ease;
  }
  .contrib-card:hover {
    border-color: color-mix(in srgb, var(--color-pink-600) 45%, var(--color-edge));
  }
  .contrib-card__art {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: 50% 35%;
    filter: saturate(0) contrast(1.18) brightness(0.5);
    opacity: 0.3;
    -webkit-mask-image: radial-gradient(110% 100% at 80% 4%, #000 10%, transparent 78%);
    mask-image: radial-gradient(110% 100% at 80% 4%, #000 10%, transparent 78%);
    transition: opacity 0.25s ease;
  }
  .contrib-card:hover .contrib-card__art {
    opacity: 0.42;
  }

  /* The closing panel carries the same photograph as the hero, so the page
     opens and closes on one image. Treated identically - monochrome, darkened,
     edge-dissolved - with the brand wash ON TOP of it rather than underneath:
     the photo layer is `filter: saturate(0)`, so a gradient sharing that
     element would be drained too, and a gradient BELOW it would simply be
     covered. Hence two layers, in paint order, with the content above both. */
  .cta-panel {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(236, 72, 153, 0.3);
    background-color: var(--color-surface);
  }
  .cta-panel__art {
    position: absolute;
    inset: 0;
    /* The same tier variable the hero uses, so this panel reuses the file the
       page has already downloaded instead of pulling a second one. */
    background-image: var(--img-trinity);
    background-size: cover;
    background-position: 50% 34%;
    filter: saturate(0) contrast(1.15) brightness(0.5);
    -webkit-mask-image: radial-gradient(125% 105% at 50% 12%, #000 12%, transparent 76%);
    mask-image: radial-gradient(125% 105% at 50% 12%, #000 12%, transparent 76%);
  }
  .cta-panel__wash {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom right,
      rgba(219, 39, 119, 0.28),
      rgba(219, 39, 119, 0.06) 55%,
      rgba(11, 17, 27, 0.55)
    );
  }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta.audiosilo.app/schema/series.schema.json",
  "title": "series",
  "description": "An ordered set of works.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "works", "license", "sources"],
  "dependentRequired": {
    "ordering_of": ["ordering"]
  },
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "description": "The series' authors as person slugs. The slug is the identity, so the list may not repeat one.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      }
    },
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work", "position"],
        "properties": {
          "work": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "position": {
            "description": "Ordering position: a number (\"1\", \"2.5\") or an omnibus range spanning several entries (\"1-3.5\").",
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?(-\\d+(\\.\\d+)?)?$"
          }
        }
      }
    },
    "translation_of": {
      "description": "A directed link from a TRANSLATED series to the series it translates (the original). A series-level claim, independent of any work-level pairing. Stated evidence only, never inferred.",
      "$ref": "common.schema.json#/$defs/slug_set"
    },
    "ordering": {
      "description": "Which reading order THIS series' positions state.",
      "$ref": "common.schema.json#/$defs/series_ordering"
    },
    "ordering_of": {
      "description": "The franchise's PRIMARY ordering, set only on a variant ordering of it. A variant must say what kind of order it is, so ordering is required beside it.",
      "$ref": "common.schema.json#/$defs/slug"
    },
    "xref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q\\d+$"
        },
        "goodreads": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "$ref": "common.schema.json#/$defs/license"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    }
  }
}

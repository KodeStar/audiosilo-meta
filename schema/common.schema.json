{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta.audiosilo.app/schema/common.schema.json",
  "title": "AudioSilo metadata - shared definitions",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "enum": ["CC0-1.0"]
    },
    "license_content": {
      "description": "The share-alike layer for community-authored expressive content (characters, recaps). Kept in a separate def so a CC0 core record can never carry it and vice versa.",
      "type": "string",
      "enum": ["CC-BY-SA-3.0"]
    },
    "position": {
      "description": "A spoiler position within a work's own timeline. chapter is the logical (edition-independent) work chapter, 1-based; 0 means front matter or knowledge carried from earlier books in a series.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter"],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "openaudible-import",
            "libation-import",
            "audiosilo-books-import",
            "libex-import",
            "audible-lookup",
            "openlibrary",
            "wikidata",
            "inventaire",
            "community"
          ]
        },
        "ref": {
          "type": "string"
        },
        "imported_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
    },
    "genre": {
      "description": "One entry from the project's own normalized genre vocabulary. It is a controlled list this project owns, not a retailer's taxonomy, so a value is only added by amending this enum.",
      "type": "string",
      "enum": [
        "action-adventure",
        "alternate-history",
        "arts-entertainment",
        "biography-memoir",
        "business",
        "childrens",
        "classics",
        "comedy-humor",
        "coming-of-age",
        "contemporary-romance",
        "cozy-mystery",
        "cyberpunk",
        "dark-fantasy",
        "drama-plays",
        "dystopian",
        "economics",
        "education",
        "epic-fantasy",
        "erotica",
        "espionage",
        "essays",
        "fairy-tales-folklore",
        "fantasy",
        "finance",
        "food-cooking",
        "ghost-stories",
        "gothic",
        "hard-boiled",
        "hard-science-fiction",
        "health-wellness",
        "historical-fiction",
        "historical-romance",
        "history",
        "home-garden",
        "horror",
        "language",
        "law",
        "legal-thriller",
        "lgbtq",
        "literary-fiction",
        "litrpg",
        "magical-realism",
        "medicine",
        "military-history",
        "military-science-fiction",
        "music",
        "mystery",
        "mythology",
        "nature",
        "occult",
        "paranormal",
        "paranormal-romance",
        "parenting-relationships",
        "philosophy",
        "poetry",
        "police-procedural",
        "politics",
        "post-apocalyptic",
        "psychological-thriller",
        "psychology",
        "religion-spirituality",
        "religious-fiction",
        "romance",
        "romantic-comedy",
        "romantic-suspense",
        "science",
        "science-fiction",
        "self-help",
        "short-stories",
        "social-sciences",
        "space-opera",
        "sports",
        "steampunk",
        "superhero",
        "sword-sorcery",
        "technology",
        "thriller-suspense",
        "time-travel",
        "travel",
        "true-crime",
        "urban-fantasy",
        "war-military-fiction",
        "westerns",
        "womens-fiction",
        "writing-publishing",
        "young-adult"
      ]
    },
    "genre_list": {
      "description": "A work's genres: at least one entry, no duplicates, drawn from the controlled vocabulary.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/genre"
      }
    },
    "isbn": {
      "type": "string",
      "pattern": "^(\\d{9}[0-9Xx]|\\d{13})$"
    },
    "isbn_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/isbn"
      }
    },
    "asin": {
      "type": "string",
      "pattern": "^[A-Z0-9]{10}$"
    },
    "date_year": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
    },
    "date_flex": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "date_day": {
      "description": "A full calendar date, YYYY-MM-DD.",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}

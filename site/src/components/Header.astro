---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import HeaderSearch from './search/HeaderSearch.tsx'

interface Props {
  /** The home page's hero owns a full-size search box, so the header's copy
      stays hidden until that one scrolls away. */
  hasHero?: boolean
}
const { hasHero = false } = Astro.props

const GITHUB = 'https://github.com/kodestar/audiosilo-meta'
const DISCORD = 'https://discord.gg/nFFqRbkRn6'

interface NavItem {
  label: string
  href: string
  external?: boolean
  /** Carries the "Watching" count pill (see the script below). On the DATA, so
      the two nav loops render it by asking the item rather than by each
      re-testing the href. */
  badge?: boolean
}

const nav: NavItem[] = [
  { label: 'Watching', href: '/watching', badge: true },
  { label: 'Import', href: '/import' },
  { label: 'Contribute', href: '/contribute' },
  { label: 'API', href: '/docs/api' },
  { label: 'Docs', href: 'https://github.com/kodestar/audiosilo-meta#readme', external: true },
  { label: 'audiosilo.app', href: 'https://audiosilo.app', external: true },
]

/** The badge pill's one spelling, worn by the desktop nav and the mobile menu
    alike. */
const WATCH_BADGE_CLASS =
  'ml-1.5 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-pink-600 px-1.5 text-[0.65rem] font-semibold leading-5 text-white'
---

<header class="site-header sticky top-0 z-50 border-b border-transparent" data-scrolled="false">
  <div class="container flex items-center gap-4 py-3">
    <!-- Brand -->
    <a class="flex items-center gap-3" href="/" aria-label="AudioSilo Meta home">
      <Logo class="w-9 shrink-0" />
      <span class="flex flex-col leading-none">
        <span class="text-lg uppercase tracking-wider text-pink-500 leading-none">
          Audio<span class="text-hi">Silo</span>
        </span>
        <span class="mt-1 text-[0.65rem] uppercase tracking-[0.2em] text-dim">Meta</span>
      </span>
    </a>

    <!-- Site-wide search: takes the middle of the bar, and on the home page
         fades in only once the hero's box has scrolled out of reach. -->
    <div class="flex flex-1 justify-end sm:justify-center">
      <HeaderSearch client:load deferToHero={hasHero} />
    </div>

    <!-- Desktop nav -->
    <nav class="hidden shrink-0 items-center gap-5 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class="text-sm font-medium text-body transition-colors hover:text-pink-500"
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {item.label}
            {item.badge && (
              <span data-watch-badge hidden aria-label="new releases" class={WATCH_BADGE_CLASS} />
            )}
          </a>
        ))
      }
      <a
        class="text-dim transition-colors hover:text-hi"
        href={DISCORD}
        target="_blank"
        rel="noopener"
        aria-label="AudioSilo on Discord"
      >
        <Icon name="discord" class="h-5 w-5" />
      </a>
      <a
        class="text-dim transition-colors hover:text-hi"
        href={GITHUB}
        target="_blank"
        rel="noopener"
        aria-label="audiosilo-meta on GitHub"
      >
        <Icon name="github" class="h-5 w-5" />
      </a>
    </nav>

    <!-- Mobile disclosure menu (no framework) -->
    <details class="site-menu relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-body transition-colors hover:text-hi"
        aria-label="Open menu"
      >
        <Icon name="menu" class="menu-open h-6 w-6" />
        <Icon name="x" class="menu-close hidden h-6 w-6" />
      </summary>
      <div
        class="absolute right-0 top-12 z-50 w-56 rounded-xl border border-edge bg-surface p-2 shadow-2xl shadow-black/40"
      >
        {
          nav.map((item) => (
            <a
              class="block rounded-lg px-3 py-2 text-sm font-medium text-body transition-colors hover:bg-raised hover:text-hi"
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.label}
              {item.badge && (
                <span data-watch-badge hidden aria-label="new releases" class={WATCH_BADGE_CLASS} />
              )}
            </a>
          ))
        }
        <a
          class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-body transition-colors hover:bg-raised hover:text-hi"
          href={DISCORD}
          target="_blank"
          rel="noopener"
        >
          <Icon name="discord" class="h-4 w-4" />
          Discord
        </a>
        <a
          class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-body transition-colors hover:bg-raised hover:text-hi"
          href={GITHUB}
          target="_blank"
          rel="noopener"
        >
          <Icon name="github" class="h-4 w-4" />
          GitHub
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-menu > summary::-webkit-details-marker {
    display: none;
  }
  .site-menu[open] .menu-open {
    display: none;
  }
  .site-menu[open] .menu-close {
    display: block;
  }
</style>

<script>
  import {
    WATCHLIST_CHANGED_EVENT,
    WATCHLIST_STORAGE_KEY,
    readWatchlist,
    type Watchlist,
  } from '../lib/watchlist'
  import {
    WATCH_BADGE_STORAGE_KEY,
    badgeCount,
    badgeSlugKey,
    fetchWatchFeedWorkIDs,
    isBadgeFresh,
    readBadgeCache,
    writeBadgeCache,
    type BadgeCache,
  } from '../lib/watch-badge'

  const header = document.querySelector<HTMLElement>('.site-header')
  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false'
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }

  const menu = document.querySelector<HTMLDetailsElement>('.site-menu')
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false
    })
  }

  // The "Watching" count pill: how many feed items the reader has not dealt
  // with, on every page. DOM glue only - the cadence, the cache's shape, the
  // privacy posture and the 90-day window are all stated in lib/watch-badge.ts's
  // header, which is where the rules live and where they are tested. Nothing
  // here loads React.
  const badges = document.querySelectorAll<HTMLElement>('[data-watch-badge]')
  if (badges.length > 0) {
    // Each pass reads the watchlist, its key and the cache ONCE and threads
    // them, so paint and refresh cannot disagree about what is stored.
    const paint = (
      store: Watchlist = readWatchlist(),
      key: string = badgeSlugKey(store),
      cache: BadgeCache | null = readBadgeCache()
    ) => {
      const count = cache && cache.slugKey === key ? badgeCount(cache.works, store) : 0
      badges.forEach((badge) => {
        badge.textContent = count > 99 ? '99+' : String(count)
        badge.hidden = count === 0
      })
    }

    const refresh = async () => {
      const store = readWatchlist()
      const key = badgeSlugKey(store)
      const cache = readBadgeCache()
      // Nothing watched, or a cache still inside its hour: no request at all,
      // and no feed-url module to load either.
      if (key === '' || isBadgeFresh(cache, key, Date.now())) {
        paint(store, key, cache)
        return
      }
      let fresh: BadgeCache | null = cache
      try {
        const { buildFeedURLs } = await import('../lib/feed-url')
        const urls = await buildFeedURLs(store)
        fresh = {
          version: 1,
          slugKey: key,
          fetchedAt: Date.now(),
          works: await fetchWatchFeedWorkIDs(urls.json),
        }
        writeBadgeCache(fresh)
      } catch {
        // Every failure degrades to "no new badge": offline, a mock API with no
        // feed route, more than 200 series (buildFeedURLs refuses), or a
        // browser without CompressionStream for a long list. The previous
        // cache, if any, still paints below.
      } finally {
        paint(store, key, fresh)
      }
    }

    // Paint the cached count first so a reader who has one sees no flash, then
    // go and see whether the feed has moved.
    paint()
    void refresh()
    // A mark made in an island of this tab (use-watchlist.ts dispatches it)...
    window.addEventListener(WATCHLIST_CHANGED_EVENT, () => paint())
    // ...and one made in another tab, which is what `storage` is for - but only
    // for the two keys this badge is a function of (a null key is a whole-origin
    // clear).
    window.addEventListener('storage', (e) => {
      if (
        e.key === null ||
        e.key === WATCHLIST_STORAGE_KEY ||
        e.key === WATCH_BADGE_STORAGE_KEY
      ) {
        paint()
      }
    })
  }
</script>

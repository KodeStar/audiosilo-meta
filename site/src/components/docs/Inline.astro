---
// Renders one line of an OpenAPI description, turning its CommonMark `code`
// spans into elements. The segments are interpolated, never injected as HTML, so
// the spec cannot introduce markup into the page. Code spans are the WHOLE
// markdown subset rendered here; the Go side fails the build on anything richer
// (TestOpenAPIProseStaysInTheRenderedSubset).
import { inlineSegments } from '../../lib/openapi'
import { CHIP } from './chip'

interface Props {
  text: string
}
const { text } = Astro.props
---

{
  inlineSegments(text).map((segment) =>
    segment.code ? (
      <code class={`${CHIP} text-[0.9em] text-hi`}>{segment.text}</code>
    ) : (
      <Fragment>{segment.text}</Fragment>
    )
  )
}

---
import Base from '../layouts/Base.astro'
import WorkDetail from '../components/detail/WorkDetail.tsx'
import { ENTITY_MARKER } from '../lib/ssr-markers'
---

<Base
  title="Work - AudioSilo Meta"
  description="An audiobook work in the AudioSilo Meta database: its authors, series, and every catalogued recording with narrators, runtimes, identifiers and chapters."
  hasHero
>
  {/* metaserve replaces this marker on /works/{slug} with the server-rendered
      fact sheet (#ssr-entity) and the entity payload (#entity-data) the island
      hydrates from; served untouched everywhere else. See internal/serve and
      the contract note in Base.astro.

      It is written through set:html because a bare `<!--ssr:entity-->` here
      would not survive the build: Astro's compiler strips HTML comments out of
      SLOT content (the head markers, which sit in Base.astro's own template,
      are kept). set:html injects the raw string verbatim. */}
  <Fragment set:html={ENTITY_MARKER} /><WorkDetail client:only="react" />
</Base>
